# Base image
FROM vault.habana.ai/gaudi-docker/1.18.0/ubuntu22.04/habanalabs/pytorch-installer-2.4.0:latest

# Set working directory
WORKDIR /workspace/sd

# Install system dependencies
RUN apt-get update && apt-get install -y \
    tzdata \
    python3-pip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip

# Install core dependencies
RUN pip install \
    numpy>=1.21.0 \
    albumentations==0.4.3 \
    diffusers \
    opencv-python-headless>=4.5.1.48 \
    pudb==2019.2 \
    invisible-watermark \
    imageio==2.9.0 \
    imageio-ffmpeg==0.4.2 \
    pytorch-lightning==1.4.2 \
    omegaconf==2.1.1 \
    test-tube>=0.7.5 \
    streamlit>=0.73.1 \
    einops==0.3.0 \
    torch-fidelity==0.3.0 \
    transformers==4.19.2 \
    torchmetrics==0.6.0 \
    kornia==0.6

# Install requirements_hpu.txt
COPY requirements_hpu.txt /workspace/sd/requirements_hpu.txt
RUN pip install -r /workspace/sd/requirements_hpu.txt

# Clone and install taming-transformers
RUN git clone --depth 1 https://github.com/CompVis/taming-transformers.git /workspace/sd/src/taming-transformers \
    && pip install -e /workspace/sd/src/taming-transformers

# Clone and install CLIP
RUN git clone --depth 1 https://github.com/openai/CLIP.git /workspace/sd/src/clip \
    && pip install -e /workspace/sd/src/clip

# Install local dependencies
COPY . /workspace/sd
RUN pip install -e .
